# Copy this file to .env for local scripts.
# In Vercel, add the same keys in Project Settings → Environment Variables.
# Never commit real tokens, webhook secrets, or invite links.

BOT1_TOKEN=
BOT2_TOKEN=

# Public usernames without @
BOT1_USERNAME=
BOT2_USERNAME=

# 1–256 characters: A–Z, a–z, 0–9, underscore, hyphen.
BOT1_WEBHOOK_SECRET=
BOT2_WEBHOOK_SECRET=

# Numeric Telegram user id. Separate multiple admins with commas.
ADMIN_TELEGRAM_ID=

# Public Vercel origin, no trailing slash.
APP_URL=

# Vercel KV credentials (auto-filled when you connect KV in Vercel dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Numeric channel IDs for each package (get via @userinfobot or forwarding a message)
# Format: -100XXXXXXXXXX  (always negative for channels)
PACKAGE_BTN1_CHANNEL_ID=
PACKAGE_BTN2_CHANNEL_ID=
PACKAGE_BTN3_CHANNEL_ID=
PACKAGE_BTN4_CHANNEL_ID=
PACKAGE_BTN5_CHANNEL_ID=
PACKAGE_BTN6_CHANNEL_ID=
PACKAGE_BTN7_CHANNEL_ID=
PACKAGE_BTN8_CHANNEL_ID=
PACKAGE_BTN9_CHANNEL_ID=
PACKAGE_BTN10_CHANNEL_ID=
PACKAGE_BTN11_CHANNEL_ID=
PACKAGE_BTN12_CHANNEL_ID=
PACKAGE_BTN13_CHANNEL_ID=
PACKAGE_BTN14_CHANNEL_ID=
PACKAGE_BTN15_CHANNEL_ID=
