# Copy this file to .env for local scripts.
# In Vercel, add the same keys in Project Settings → Environment Variables.
# Never commit real tokens, webhook secrets, or invite links.

BOT1_TOKEN=
BOT2_TOKEN=

# Public usernames without @
BOT1_USERNAME=
BOT2_USERNAME=

# 1–256 characters: A–Z, a–z, 0–9, underscore, hyphen.
# Telegram sends this value in X-Telegram-Bot-Api-Secret-Token.
BOT1_WEBHOOK_SECRET=
BOT2_WEBHOOK_SECRET=

# Numeric Telegram user id. Separate multiple admins with commas.
ADMIN_TELEGRAM_ID=

# Public Vercel origin, no trailing slash. Example: https://your-app.vercel.app
APP_URL=

# One Telegram Stars paid-channel invite per package.
# Use the https://t.me/... link Telegram gives you for that private channel.
# These values are read only on the server. Do not put them in config/packages.json.
PACKAGE_BASIC_INVITE_LINK=
PACKAGE_PREMIUM_INVITE_LINK=
PACKAGE_VIP_INVITE_LINK=

# Optional. When set, this JSON replaces config/packages.json.
# Do not put invite URLs in this JSON. Point each package at an env var name.
# PACKAGES_JSON=
