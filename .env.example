# SECURITY RULES:
# 1. Never commit this file with real values — .env is in .gitignore
# 2. Never share bot tokens, webhook secrets, or KV tokens in chat or public channels
# 3. Rotate tokens immediately if accidentally exposed
# 4. Use strong random webhook secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 5. Keep BOT1_WEBHOOK_SECRET and BOT2_WEBHOOK_SECRET different from each other

BOT1_TOKEN=
BOT2_TOKEN=

BOT1_USERNAME=
BOT2_USERNAME=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT1_WEBHOOK_SECRET=
BOT2_WEBHOOK_SECRET=

# Your numeric Telegram user ID — get from @userinfobot
ADMIN_TELEGRAM_ID=

# Your Vercel deployment URL, no trailing slash
APP_URL=

# Upstash Redis — from Vercel dashboard → Storage → your database → .env.local tab
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Numeric channel IDs with -100 prefix (e.g. -1001234567890)
# Get via: forward a channel message to @RawDataBot
PACKAGE_BTN1_CHANNEL_ID=
PACKAGE_BTN2_CHANNEL_ID=
PACKAGE_BTN3_CHANNEL_ID=
PACKAGE_BTN4_CHANNEL_ID=
PACKAGE_BTN5_CHANNEL_ID=
PACKAGE_BTN6_CHANNEL_ID=
PACKAGE_BTN7_CHANNEL_ID=
PACKAGE_BTN8_CHANNEL_ID=
PACKAGE_BTN9_CHANNEL_ID=
PACKAGE_BTN10_CHANNEL_ID=
PACKAGE_BTN11_CHANNEL_ID=
PACKAGE_BTN12_CHANNEL_ID=
PACKAGE_BTN13_CHANNEL_ID=
PACKAGE_BTN14_CHANNEL_ID=
PACKAGE_BTN15_CHANNEL_ID=
