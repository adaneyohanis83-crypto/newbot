{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["api/**/*.js", "src/**/*.js", "tests/**/*.js", "scripts/**/*.js", "config/packages.json"],
  "exclude": ["node_modules"]
}
